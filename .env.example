# Copy to .env and edit. Never commit .env.
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
JWT_SECRET=change-me-to-a-long-random-string

# Embeddings: "hashing" (offline, no downloads) or "sbert" (sentence-transformers, better quality)
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384

# Answer generation: "extractive" (no API key needed) or "anthropic"
LLM_PROVIDER=extractive
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
